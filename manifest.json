{
  "manifest_version": 3,
  "name": "Spotted. Beta: Dope Daily Ad Campaigns",
  "short_name": "Spotted.",
  "version": "0.1.0",
  "version_name": "0.1 beta",
  "description": "Beta. A dope new ad campaign revealed every weekday at midday. Who made it (agency or in-house) and why it's good.",
  "action": {
    "default_title": "Spotted.",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ]
}
